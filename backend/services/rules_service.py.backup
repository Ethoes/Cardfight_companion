import faiss
import json
import numpy as np
import requests
import os
from sentence_transformers import SentenceTransformer
from database.feedback_service import search_similar_good_feedback

class VanguardRulesService:
    """Service for handling Cardfight!! Vanguard rules questions using AI"""
    
    def __init__(self):
        # Paths relative to the backend directory
        self.base_path = os.path.dirname(os.path.dirname(__file__))  # backend directory
        self.meta_path = os.path.join(self.base_path, "vanguard_metadata.json")
        self.index_path = os.path.join(self.base_path, "vanguard_index.faiss")
        
        # Model configuration
        self.model = "gpt-4o"
        self.api_key = os.getenv("OPENAI_API_KEY")
        
        # Initialize components
        self.index = None
        self.metadata = None
        self.embedding_model = None
        
        self._load_components()
    
    def _load_components(self):
        """Load FAISS index, metadata, and embedding model"""
        try:
            # Load FAISS index
            if os.path.exists(self.index_path):
                self.index = faiss.read_index(self.index_path)
            else:
                raise FileNotFoundError(f"FAISS index not found at {self.index_path}")
            
            # Load metadata
            if os.path.exists(self.meta_path):
                with open(self.meta_path, "r", encoding="utf-8") as f:
                    self.metadata = json.load(f)
            else:
                raise FileNotFoundError(f"Metadata file not found at {self.meta_path}")
            
            # Load embedding model
            self.embedding_model = SentenceTransformer("all-MiniLM-L6-v2")
            
            print(f"✅ Rules service loaded successfully")
            print(f"   - Index size: {self.index.ntotal} entries")
            print(f"   - Metadata entries: {len(self.metadata)}")
            
        except Exception as e:
            print(f"❌ Error loading rules service: {str(e)}")
            raise
    
    def get_embedding(self, query):
        """Generate embedding for a query"""
        return np.array(self.embedding_model.encode(query), dtype=np.float32)
    
    def search_rules(self, query, k=20, min_similarity_threshold=0.3):  # Increased from k=3
        """Search for relevant rules based on the query"""
        if not self.index or not self.metadata:
            raise RuntimeError("Rules service not properly initialized")
        
        emb = self.get_embedding(query)
        D, I = self.index.search(np.array([emb]), k)
        
        # Filter results by similarity threshold
        # D contains squared L2 distances - convert to similarities
        # Lower distances = higher similarity
        relevant_results = []
        found_sections = set()
        
        for i, (distance, idx) in enumerate(zip(D[0], I[0])):
            # Convert distance to similarity (rough approximation)
            similarity = 1 / (1 + distance)  # Simple distance-to-similarity conversion
            
            if similarity >= min_similarity_threshold:
                result = self.metadata[idx].copy()
                result['similarity'] = similarity
                result['source'] = 'user_question'  # Track source of this result
                relevant_results.append(result)
                found_sections.add(result['section'])
        
        # Add context expansion: include adjacent numbered sections
        expanded_results = relevant_results.copy()
        for result in relevant_results:
            section = result['section']
            # Find related sections (adjacent numbered rules)
            related_sections = self._find_related_sections(section, found_sections)
            for related_section in related_sections:
                # Find this section in metadata
                for metadata_item in self.metadata:
                    if metadata_item['section'] == related_section and related_section not in found_sections:
                        expanded_result = metadata_item.copy()
                        expanded_result['similarity'] = 0.25  # Lower similarity for related sections
                        expanded_result['source'] = 'context_expansion'  # Track source
                        expanded_results.append(expanded_result)
                        found_sections.add(related_section)
                        break
        
        # Sort by similarity and limit results
        expanded_results.sort(key=lambda x: x['similarity'], reverse=True)
        return expanded_results[:15]  # Return top 15 results including context
    
    def _find_related_sections(self, section, already_found):
        """Find adjacent numbered sections for better context"""
        related = []
        try:
            # Parse section number (e.g., "9.7.2" -> base="9.7", subsection="2")
            if section.count('.') >= 2:
                parts = section.split('.')
                if len(parts) >= 3:
                    base = f"{parts[0]}.{parts[1]}"
                    subsection_num = int(parts[2]) if parts[2].isdigit() else 0
                    
                    # Add adjacent subsections
                    for offset in [-1, 1]:
                        new_subsection = subsection_num + offset
                        if new_subsection > 0:
                            candidate = f"{base}.{new_subsection}."
                            if candidate not in already_found:
                                related.append(candidate)
                    
                    # Also add the parent section
                    parent = f"{base}."
                    if parent not in already_found:
                        related.append(parent)
            
            elif section.count('.') == 1:
                # For sections like "9.7.", add subsections 9.7.1., 9.7.2., etc.
                base = section.rstrip('.')
                for i in range(1, 4):  # Add first 3 subsections
                    candidate = f"{base}.{i}."
                    if candidate not in already_found:
                        related.append(candidate)
        
        except (ValueError, IndexError):
            pass  # Skip if section format is unexpected
            
        return related
    
    def ask_openai_chatbot(self, prompt):
        """Send prompt to OpenAI API and get response"""
        if not self.api_key:
            raise ValueError("OpenAI API key not set. Please set OPENAI_API_KEY environment variable.")
        
        headers = {
            "Authorization": f"Bearer {self.api_key}",
            "Content-Type": "application/json"
        }
        
        payload = {
            "model": self.model,
            "messages": [
                {"role": "user", "content": prompt}
            ],
            "max_tokens": 1000,
            "temperature": 0.7
        }
        
        try:
            response = requests.post(
                "https://api.openai.com/v1/chat/completions",
                headers=headers,
                json=payload,
                timeout=30
            )
            response.raise_for_status()
            
            data = response.json()
            return data["choices"][0]["message"]["content"]
            
        except requests.exceptions.RequestException as e:
            raise Exception(f"OpenAI API request failed: {str(e)}")
        except (KeyError, IndexError) as e:
            raise Exception(f"Unexpected API response format: {str(e)}")
    
    def build_prompt(self, context_chunks, user_question, good_feedback=None):
        """Build the prompt for the AI with context, question, and good feedback examples"""
        if not context_chunks:
            return None
            
        context = "\n\n".join(
            [f"[{c['section']}] {c['text']}" for c in context_chunks]
        )
        
        # Add good feedback examples if available
        feedback_section = ""
        if good_feedback and len(good_feedback) > 0:
            feedback_examples = "\n\n".join([
                f"Example Q: {fb['question']}\nExample A: {fb['answer']}"
                for fb in good_feedback[:3]  # Limit to 3 examples to avoid prompt bloat
            ])
            feedback_section = f"\n\nRelevant Previous Questions & Verified Answers:\n{feedback_examples}\n"
        
        prompt = f"""You are a Cardfight!! Vanguard rules assistant. Answer the user's question using the rule excerpts provided below.

IMPORTANT INSTRUCTIONS:
- Use the provided rule excerpts to answer the question as best you can
- Make logical inferences from the rules when they clearly imply an answer
- If rules describe zones as distinct or separate, use that to determine what is/isn't included
- When rules define specific zones (like gauge zones, damage zones), these are typically separate from "field" unless explicitly stated otherwise
- In Cardfight Vanguard, "field" typically refers to circles where units are placed (vanguard circle, rear-guard circles)
- Cite the relevant rule sections in your answer (e.g., "According to Rule 7.1.2...")
- Only respond with "I don't have sufficient information in the rulebook to answer this question accurately" if the excerpts are completely unrelated to the question
- Be helpful and provide useful guidance based on the available rules and standard game mechanics{0}

Key Logic: If rules mention zones being distinct/separate or having specific purposes, they are usually not part of the general "field"

Rulebook Excerpts:
{}

User Question:
{}

Provide a helpful answer based on the rule excerpts above:"""
        
        return prompt
    
    def extract_card_context(self, question):
        """Extract card context and user question from formatted input"""
        if "Context Cards:" not in question or "Question:" not in question:
            return [], question.strip()
        
        parts = question.split("Question:")
        if len(parts) != 2:
            return [], question.strip()
        
        card_context_section = parts[0].replace("Context Cards:", "").strip()
        user_question = parts[1].strip()
        
        # Parse individual cards
        cards = []
        if card_context_section:
            # Split by double newlines to get individual cards
            card_blocks = [block.strip() for block in card_context_section.split("\n\n") if block.strip()]
            
            for block in card_blocks:
                card_info = {}
                lines = [line.strip() for line in block.split("\n") if line.strip()]
                
                for line in lines:
                    if line.startswith("Card: "):
                        card_info['name'] = line.replace("Card: ", "")
                    elif line.startswith("Effect: "):
                        card_info['effect'] = line.replace("Effect: ", "")
                    elif line.startswith("Type: "):
                        card_info['type'] = line.replace("Type: ", "")
                    elif line.startswith("Grade: "):
                        card_info['grade'] = line.replace("Grade: ", "")
                    elif line.startswith("Power: "):
                        card_info['power'] = line.replace("Power: ", "")
                    elif line.startswith("Nation/Clan: "):
                        card_info['nation_clan'] = line.replace("Nation/Clan: ", "")
                
                if card_info:
                    cards.append(card_info)
        
        return cards, user_question
    
    def search_with_card_context(self, question, min_similarity_threshold=0.3):
        """Enhanced search that includes card effects and good feedback as search context"""
        # Extract card context and user question
        cards, user_question = self.extract_card_context(question)
        
        all_results = []
        seen_sections = set()
        
        # Search for similar good feedback examples
        good_feedback = []
        try:
            good_feedback = search_similar_good_feedback(user_question, limit=3)
            print(f"[DEBUG] Found {len(good_feedback)} similar good feedback examples")
        except Exception as e:
            print(f"[DEBUG] Error searching good feedback: {e}")
        
        # Search with user question
        user_results = self.search_rules(user_question, min_similarity_threshold=min_similarity_threshold)
        for result in user_results:
            if result['section'] not in seen_sections:
                result['source'] = 'user_question'
                all_results.append(result)
                seen_sections.add(result['section'])
        
        # Also search for specific key terms from the question
        key_terms = self._extract_question_keywords(user_question)
        for term in key_terms:
            print(f"[DEBUG] Searching for key term: '{term}'")
            try:
                term_results = self.search_rules(term, k=8, min_similarity_threshold=0.15)  # Lower threshold for key terms
                for result in term_results:
                    if result['section'] not in seen_sections:
                        result['source'] = f'key_term_{term}'
                        all_results.append(result)
                        seen_sections.add(result['section'])
            except Exception as e:
                print(f"[DEBUG] Error searching key term '{term}': {e}")
                continue
        
        # For zone definition questions, add specific definitional searches
        if any(word in user_question.lower() for word in ['field', 'zone', 'gauge', 'area']):
            definition_terms = ['game area', 'area definition', 'zone', 'circle definition', 'placement', 'located', 'considered']
            for term in definition_terms:
                try:
                    def_results = self.search_rules(term, k=5, min_similarity_threshold=0.1)  # Very low threshold
                    for result in def_results:
                        if result['section'] not in seen_sections:
                            result['source'] = f'definition_{term}'
                            all_results.append(result)
                            seen_sections.add(result['section'])
                except Exception as e:
                    continue
        
        # Search with card effects for additional context
        for card in cards:
            effect = card.get('effect', '')
            if effect and effect != 'N/A':
                # Extract key terms from card effect for searching
                search_terms = self._extract_effect_keywords(effect)
                for term in search_terms:
                    if len(term) > 3:  # Only search meaningful terms
                        try:
                            effect_results = self.search_rules(term, k=10, min_similarity_threshold=min_similarity_threshold-0.05)
                            for result in effect_results:
                                if result['section'] not in seen_sections:
                                    # Mark as card-effect-derived with slightly lower similarity
                                    result['similarity'] = result['similarity'] * 0.9  
                                    result['source'] = f"card_effect_{card.get('name', 'unknown')}"
                                    all_results.append(result)
                                    seen_sections.add(result['section'])
                        except Exception as e:
                            print(f"[DEBUG] Error searching with card effect term '{term}': {e}")
                            continue
        
        # Sort by similarity and return top results
        all_results.sort(key=lambda x: x['similarity'], reverse=True)
        return all_results[:20]  # Return top 20 results
    
    def _extract_question_keywords(self, question):
        """Extract key terms from user questions for targeted rule searching"""
        import re
        
        # Important Vanguard game terms that should be searched specifically
        vanguard_terms = [
            'equipment gauge', 'gauge', 'field', 'removed', 'remove', 'removed from field',
            'vanguard circle', 'rear-guard', 'rear guard', 'circle', 'zones',
            'drive check', 'damage', 'soul', 'drop zone', 'hand',
            'stride', 'ride', 'call', 'attack', 'battle', 'guard',
            'stand', 'rest', 'retire', 'superior call',
            'trigger', 'critical', 'front trigger', 'heal trigger',
            'grade', 'power', 'shield', 'cost',
            'legion', 'mate', 'persona ride',
            'overtrigger', 'order', 'normal order', 'blitz order',
            'zone', 'deck', 'bind zone', 'g zone', 'damage zone',
            'face up', 'face down', 'top', 'bottom',
            'game areas', 'area', 'placed', 'location'
        ]
        
        keywords = []
        question_lower = question.lower()
        
        # Find Vanguard-specific terms in the question
        for term in vanguard_terms:
            if term in question_lower:
                keywords.append(term)
        
        # Add specific definitional searches for field/zone questions
        if 'field' in question_lower:
            keywords.extend(['game area', 'game areas', 'zone definition', 'zones', 'placed', 'location'])
            
        if 'gauge' in question_lower and 'field' in question_lower:
            keywords.extend(['zone classification', 'separate', 'distinct', 'area', 'game areas'])
        
        # Also extract quoted text or phrases with specific game mechanics
        quoted_matches = re.findall(r'"([^"]+)"', question)
        keywords.extend(quoted_matches)
        
        # Extract numbers that might be relevant (like "3 removed")
        number_context = re.findall(r'(\d+)\s+(\w+)', question_lower)
        for num, context in number_context:
            if context in ['removed', 'damage', 'soul', 'power', 'grade']:
                keywords.append(f"{num} {context}")
        
        return list(set(keywords))  # Remove duplicates
    
    def _extract_effect_keywords(self, effect_text):
        """Extract key searchable terms from card effect text"""
        # Common Vanguard keywords and mechanics to search for
        keywords = []
        
        # Remove common brackets and formatting
        clean_effect = effect_text.replace('[', '').replace(']', '').replace('(', '').replace(')', '')
        
        # Key game terms to search for
        vanguard_terms = [
            'attack', 'attacks', 'battle', 'guard', 'drive check', 'damage check',
            'ride', 'stride', 'superior call', 'superior ride', 'soul charge', 'soul blast',
            'counter blast', 'retire', 'return', 'draw', 'discard', 'bind', 'lock',
            'stand', 'rest', 'power', 'critical', 'shield', 'grade', 'vanguard', 'rear-guard',
            'trigger', 'twin drive', 'intercept', 'boost', 'persona ride', 'legion',
            'generation break', 'limit break', 'imaginary gift', 'force', 'accel', 'protect'
        ]
        
        # Find terms in the effect
        clean_lower = clean_effect.lower()
        for term in vanguard_terms:
            if term in clean_lower:
                keywords.append(term)
        
        # Also add the first few words of the effect
        words = clean_effect.split()[:5]  # First 5 words
        for word in words:
            if len(word) > 3 and word.lower() not in ['auto', 'cont', 'act', 'when', 'this', 'unit', 'gets', 'until']:
                keywords.append(word.lower())
        
        return list(set(keywords))  # Remove duplicates
    
    def answer_question(self, question, min_similarity_threshold=0.3, min_context_chunks=1):
        """Main method to answer a rules question with good feedback context"""
        try:
            # Use enhanced search that includes card context and feedback
            top_chunks = self.search_with_card_context(question, min_similarity_threshold=min_similarity_threshold)
            
            # Get good feedback examples for context
            good_feedback = []
            try:
                cards, user_question = self.extract_card_context(question)
                good_feedback = search_similar_good_feedback(user_question, limit=3)
                if good_feedback:
                    print(f"[DEBUG] Using {len(good_feedback)} good feedback examples for better context")
            except Exception as e:
                print(f"[DEBUG] Could not fetch good feedback examples: {e}")
            
            # Check if we have enough relevant context
            if len(top_chunks) < min_context_chunks:
                return {
                    "success": True,
                    "answer": "I don't have sufficient information in the rulebook to answer this question accurately. The question might be too specific, unclear, or about content not covered in the available rules.",
                    "context_sources": [],
                    "relevance_info": {
                        "found_chunks": len(top_chunks),
                        "min_required": min_context_chunks,
                        "similarity_threshold": min_similarity_threshold
                    }
                }
            
            # Log the similarity scores for debugging
            similarities = [float(chunk.get('similarity', 0)) for chunk in top_chunks]  # Convert numpy float32 to Python float
            print(f"[DEBUG] Found {len(top_chunks)} relevant chunks with similarities: {similarities}")
            
            # Debug: Show which rules were found
            for i, chunk in enumerate(top_chunks[:5]):  # Show first 5 rules found
                print(f"[DEBUG] Rule {i+1}: {chunk['section']} - {chunk['text'][:100]}... (sim: {chunk.get('similarity', 0):.3f})")
            
            # Log sources of rules (user question vs card effects)
            sources = {}
            for chunk in top_chunks:
                source = chunk.get('source', 'user_question')
                sources[source] = sources.get(source, 0) + 1
            print(f"[DEBUG] Rule sources: {sources}")
            
            # Build prompt with context and good feedback
            prompt = self.build_prompt(top_chunks, question, good_feedback)
            if not prompt:
                return {
                    "success": True,
                    "answer": "I don't have sufficient information in the rulebook to answer this question accurately.",
                    "context_sources": []
                }
            
            # Get answer from AI
            answer = self.ask_openai_chatbot(prompt)
            print(f"[DEBUG] AI Response: {answer[:200]}...")  # Log first 200 chars of response
            
            # Check if AI says it doesn't have enough info (be more specific)
            insufficient_info_phrases = [
                "i don't have sufficient information in the rulebook",
                "don't have sufficient information in the rulebook",
                "not enough information in the provided rules",
                "insufficient information in the rulebook"
            ]
            
            # Only trigger fallback if AI explicitly says the rulebook lacks info
            if any(phrase in answer.lower() for phrase in insufficient_info_phrases):
                return {
                    "success": True,
                    "answer": "I don't have sufficient information in the rulebook to answer this question accurately. You might want to consult the full rulebook or contact a judge for clarification.",
                    "context_sources": [chunk['section'] for chunk in top_chunks],
                    "relevance_info": {
                        "ai_indicated_insufficient": True,
                        "found_chunks": len(top_chunks),
                        "similarity_scores": similarities
                    }
                }
            
            return {
                "success": True,
                "answer": answer,
                "context_sources": [chunk['section'] for chunk in top_chunks],
                "relevance_info": {
                    "found_chunks": len(top_chunks),
                    "similarity_scores": similarities
                }
            }
            
        except Exception as e:
            return {
                "success": False,
                "error": str(e),
                "answer": None,
                "context_sources": []
            }

# Global instance - will be initialized when the module is imported
rules_service = None

def get_rules_service():
    """Get or create the global rules service instance"""
    global rules_service
    if rules_service is None:
        rules_service = VanguardRulesService()
    return rules_service



